[Unit]
Description=TrackList Go Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tracklist
ExecStart=/opt/tracklist/tracklist-api
Restart=always
RestartSec=5
EnvironmentFile=/opt/tracklist/.env

# Security & Resource Sandboxing
LimitNOFILE=65536
MemoryMax=250M

[Install]
WantedBy=multi-user.target
